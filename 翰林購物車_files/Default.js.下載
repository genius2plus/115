    //手機載具驗證
    function isValidMobile(barcode) {
        var upperCaseBarcode = barcode.toUpperCase(); // 將輸入轉換為大寫
        if (!barcode) 
            return false; // 空值直接判斷為無效
        if (upperCaseBarcode.length !== 8) 
            return false; // 長度必須為 8 碼
        if (upperCaseBarcode.charAt(0) !== '/') 
            return false; // 第一碼必須為 "/"        
        var pattern = /^[0-9A-Z.\-+]{7}$/;
        return pattern.test(upperCaseBarcode.substring(1)); // 驗證後 7 碼 (已轉換為大寫)
    }
