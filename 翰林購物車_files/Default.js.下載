    BS.History.add = function (e) {//新增點閱紀錄
        var record = BS.Cookie('his').split(',');
        var tar = '', gap = '', mtrl_seq = e.split('_')[0];
        for (var i = 0; i < record.length; i++) {//移除舊紀錄
            if (record[i] != '') {
                if (record[i].indexOf(mtrl_seq + '_') == -1 && record[i].indexOf('undefined') == -1) {
                    tar += gap + record[i];
                    gap = ',';
                }
            }
        }
        var now = new Date();
        var year = now.getFullYear();
        var month = (now.getMonth() + 1).toString().padStart(2, '0'); // 月份從0開始，所以要加1
        var day = now.getDate().toString().padStart(2, '0');
        var hours = now.getHours().toString().padStart(2, '0');
        var minutes = now.getMinutes().toString().padStart(2, '0');
        var seconds = now.getSeconds().toString().padStart(2, '0');

        if (mtrl_seq.indexOf('undefined') == -1)
            tar += gap + mtrl_seq + '_' + year + month + day + hours + minutes + seconds;
        BS.Cookie.remove('his');
        BS.Cookie.add('his', tar);
        BS.History();
