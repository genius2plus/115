    BS.Event.BT_Carousel= function (e) {//指定輪播頁面
        var img = $('#Carousel img');
        for (var i = 0; i < img.length; i++) {
            $('#Carousel input:nth-child(' + (i + 1) + ')').css('color', '#666666');
            if ((i + 1) == $(e).val()) {
                $(img[i]).css('display', 'block');
                Index_a = i;
            }
            else
                $(img[i]).css('display', 'none');
        }
        $(e).css('color', 'orangered');
    }
    BS.Event.BT_Count = function (e) {
        if ($(e).val() == '-') {
            var qty = parseInt($($(e).next()).val());
            if (qty > 1) {
                qty--;
                $($(e).next()).val(qty).change();
            }
        }
        else {
            var qty = parseInt($($(e).prev()).val());
            if (qty < 200) {
                qty++;
                $($(e).prev()).val(qty).change();
            }
        }
    }
    BS.Event.BT_Eye = function (e) {//密碼顯示隱藏
        var txt = $(e).prev(); 
