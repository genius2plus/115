var run = false;
$(document).ready(function () {
    if (run == false) {
        BS.Event();
        BS.Cart();
        run = true;
    }
});
$(window).on('load', function () {
    if (run == false) {
        BS.Event();
        BS.Cart();
    }
});
$(window).scroll(function () {//滾軸移動
    /*手機版*/if (BS.Cookie('Mobile') == '1') {
        if ($(window).scrollTop() > 0) {
            $('#BT_GoTop').css({//置頂按鈕
                left: window.innerWidth - 100,
                top: window.innerHeight - 100,
                display: 'block'
            });
        }
        else 
            $('#BT_GoTop').css('display', 'none');
    }
    /*電腦版*/else {
        if ($('#Menu_Hist')[0]) {//瀏覽紀錄
            if (144 < $(window).scrollTop())
                $('#Menu_Hist').css('top', $(window).scrollTop());
        } 
    }
});
