/*Cookie存取*/{
    BS.Cookie = function (e) {
        var value = '', gap = '';
        var tmp = document.cookie.split(';');
        for (var j = 0; j < tmp.length; j++) {
            if (tmp[j].includes(e + '=')) {
                var m = tmp[j].replace(e + '=', '').split(',');
                for (var i = 0; i < m.length; i++) {
                    if ( myTrim(m[i]) != '' && value.indexOf(myTrim(m[i])) == -1) {
                        if (m[i].includes('=') )
                            break;
                        value += gap +  myTrim(m[i]);
                        gap = ',';
                    }
                }
            }
        }
        return value;
    };
    BS.Cookie.add = function (obj, e) {//Cookie加值
        var value = BS.Cookie(obj);
        if (!value.includes(e)) { 
            value +=  (value.length > 0?',':'') + e; 
        }
        BS.Cookie.assign(obj, value);
    };
    BS.Cookie.assign = function (obj, e) {//Cookie加值
        document.cookie = obj+'=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/';//設定過期
        date = new Date();
        date.setTime(date.getTime() + (24 * 60 * 60 * 1000));
        document.cookie = obj + '='+e+'; expires=' + date.toGMTString() + ';path=/';//設定新日期
    };
    BS.Cookie.remove = function (e) {//Cookie移除
        document.cookie = e + '=;';
        document.cookie = e + '=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/';//設過期
    }
}
/*購物車紀錄*/{
    BS.Cart = function () {//設定購物車品項已選
        var product = BS.Cookie('Cart');
        var tmp = product.split(',');
        var cnt = 0;
        for (var i = 0; i < tmp.length; i++) {
            if ( myTrim(tmp[i]) != '' && tmp[i].indexOf('undefined') == -1)
                cnt++;
        }
        $('.Span_Cart').each(function () { $(this).html(cnt) });
        //設定已選和數量
        var str = ',' + product + ',';
        if ($('#Body_DDL_Qty')[0]) {//產品資訊預設數量
            var mtrl_seq = $('#Body_Mtrl_Seq').val();
            var qty = '1'; 
            if (str.includes(',' + mtrl_seq + '_')) {
                for (var i = 0; i < tmp.length; i++) {
                    if (tmp[i].includes(mtrl_seq + '_')) {
                        qty = tmp[i].split('_')[1];
                        break;
                    }
                }
            }
            $('#Body_DDL_Qty').val(qty);
        }
        else if ($('.Grid_Cart select')[0]) {//購物車預設數量
            $('.Grid_Cart select').each(function () {
                var mtrl_seq = $(this).attr('mtrl_seq');
                if (str.includes(',' + mtrl_seq + '_')) {
                    for (var i = 0; i < tmp.length; i++) {
                        if (tmp[i].includes(mtrl_seq + '_')) {
                            $(this).val(tmp[i].split('_')[1]);
                            break;
                        }
                    }
                }
            });
        }
        else if ($(".Original input[onclick='BS.Cart.AddCart(this);']")[0]) {//設定已加入樣式
            $(".Original input[onclick='BS.Cart.AddCart(this);']").each(function () {
                var mtrl_seq = $(this).attr('mtrl_seq');
                if (str.includes(',' + mtrl_seq + '_'))
                    $($(this).closest('.Original')[0]).addClass('Select');
            });
        }
    }
    BS.Cart.add = function (e) {//加入購物車
        var product = BS.Cookie('Cart').split(',');
        var mtrl_seq = e.split('_')[0], qty = e.split('_')[1];
        var tar = product.filter(item => item && item.indexOf(mtrl_seq + '_') === -1 && item.indexOf('undefined') === -1).join(',');
        if (mtrl_seq.indexOf('undefined') == -1)
            tar += (tar.trim()!=''?',':'') + mtrl_seq + '_' + qty;
        BS.Cookie.remove('Cart');
        BS.Cookie.add('Cart', tar);
        BS.Cart();
    }
    BS.Cart.AddCart = function (e) {//加入購物車
        BS.Cart.add($(e).attr('mtrl_seq') + '_' + ($('#Body_DDL_Qty')[0] ? $('#Body_DDL_Qty').val() : '1'));
    }
    BS.Cart.CartCount = function () {//購物車金額合計
        var tr = $('.Grid_Cart tr');
        var total = 0, qtys = 0;
        for (var i = 0; i < tr.length; i++) {
            if ($(tr[i]).find('img')[0]) {
                var prc = parseInt($($(tr[i]).find('span')[0]).text());
                var qty = parseInt($(tr[i]).find('select').val());
                var amt = prc * qty;
                if ($(tr[i]).find('span')[0])
                    $($(tr[i]).find('span')[1]).text(amt);
                total += amt;
                qtys += qty;
            }
        }
        $('#Body_LB_Amt').text(total);//總金額
        $('#TotalBook').text($('.Grid_Cart img').length);//總品項
        $('#TotalQty').text(qtys);//總數量
        if ($('#DIV_Total')[0]) {
            $('#DIV_Total').html('總計金額：<font color="OrangeRed">' + total + '</font>元')
        }
    }
