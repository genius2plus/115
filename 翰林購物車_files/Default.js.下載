    //亂數
    function RandomString(digits) {
        var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        var result = '';
        var charactersLength = characters.length;
        for (var i = 0; i < digits; i++) {
            result += characters.charAt(Math.floor(Math.random() * charactersLength));
        }
        return result;
    }
    //清空白
    function myTrim(str) {
        return str.replace(/^[\s\uFEFF\xA0]+|[\s\uFEFF\xA0]+$/g, '');
    }
    //回上頁非目前頁）
    function GoBack() {
        var currentUrl = window.location.href;
        var referrerUrl = document.referrer;
        if (referrerUrl && referrerUrl !== currentUrl) {
            window.location.href = referrerUrl;
        }
        else {
            // 從 sessionStorage 讀取紀錄（使用自訂分隔字串）
            var historyStackStr = sessionStorage.getItem('historyStack') || '';
            var historyStack = historyStackStr ? historyStackStr.split('|') : [];
            if (historyStack.length > 1) {
                historyStack.pop(); // 移除當前頁
                var lastPage = historyStack.pop(); // 取得上一個頁面
                sessionStorage.setItem('historyStack', historyStack.join('|')); // 更新紀錄
                if (lastPage && lastPage !== currentUrl) {
                    window.location.href = lastPage;
                } else {
                    window.location.href = '/'; // fallback
                }
            }
            else {
                window.location.href = '/'; // fallback 頁
            }
        }
    }
    //記錄目前頁面（非重複）
    (function trackPageHistory() {
        var currentUrl = window.location.href;
        var historyStackStr = sessionStorage.getItem('historyStack') || '';
        var historyStack = historyStackStr ? historyStackStr.split('|') : [];

        if (historyStack.length === 0 || historyStack[historyStack.length - 1] !== currentUrl) {
            historyStack.push(currentUrl);
            sessionStorage.setItem('historyStack', historyStack.join('|'));
        }
    })();
    //解碼
    function hexToText(hexString) {
        var text = '';
        for (var i = 0; i < hexString.length; i += 2) {
            var hexCode = hexString.substring(i, i + 2);
            var charCode = parseInt(hexCode, 16);
            text += String.fromCharCode(charCode);
        }
        return text;
    }
