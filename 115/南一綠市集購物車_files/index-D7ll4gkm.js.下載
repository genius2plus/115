  position: relative;
}
.nuka-overflow {
  overflow: scroll;
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.nuka-overflow.scroll-smooth {
  scroll-behavior: smooth;
}
.nuka-overflow.scroll-auto {
  scroll-behavior: auto;
}
